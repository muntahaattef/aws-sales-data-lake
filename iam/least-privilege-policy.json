{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyProjectPrefixes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::BUCKET_NAME",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["YOUR_PREFIX/*", "athena-results/*"]
        }
      }
    },
    {
      "Sid": "ProjectObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::BUCKET_NAME/YOUR_PREFIX/*",
        "arn:aws:s3:::BUCKET_NAME/athena-results/*"
      ]
    },
    {
      "Sid": "AthenaQueries",
      "Effect": "Allow",
      "Action": ["athena:StartQueryExecution", "athena:GetQueryExecution", "athena:GetQueryResults", "athena:StopQueryExecution"],
      "Resource": "arn:aws:athena:REGION:ACCOUNT_ID:workgroup/primary"
    },
    {
      "Sid": "GlueCatalogForSalesLake",
      "Effect": "Allow",
      "Action": [
        "glue:GetDatabase", "glue:CreateDatabase", "glue:GetTable", "glue:CreateTable",
        "glue:UpdateTable", "glue:GetPartitions", "glue:BatchCreatePartition"
      ],
      "Resource": [
        "arn:aws:glue:REGION:ACCOUNT_ID:catalog",
        "arn:aws:glue:REGION:ACCOUNT_ID:database/sales_lake",
        "arn:aws:glue:REGION:ACCOUNT_ID:table/sales_lake/*"
      ]
    }
  ]
}

